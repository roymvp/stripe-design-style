{
  "name": "@design-systems/stripe-style",
  "version": "0.1.0",
  "description": "独立的 stripe 风格 UI 系统；非官方，仅依据指定 DESIGN.md 实现。",
  "type": "module",
  "sideEffects": ["**/*.css"],
